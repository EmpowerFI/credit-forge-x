{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/about", "destination": "/about", "permanent": true },
    { "source": "/en/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/en/terms", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets/|app/diario-sw\\.js|app/diario\\.webmanifest|app/diario-icons/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/app/diario-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/app/diario.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
