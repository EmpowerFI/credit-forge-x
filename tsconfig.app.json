{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@empowerfi/audit-commitments": [
        "./packages/audit-commitments/src/index.ts"
      ],
      "@empowerfi/audit-client": [
        "./packages/audit-client/src/generated/index.ts"
      ],
      "@empowerfi/readiness-engine": [
        "./packages/readiness-engine/src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "packages"
  ]
}
