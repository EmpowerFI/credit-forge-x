# Supabase (public-safe, build-time — prefixed VITE_ so they ship in the client bundle)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase-anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# The platform database behind /app. This one variable decides which building
# the build is:
#
#   the showroom project  -> persona cards, one-click entry, "simulated data"
#   anything else         -> a credentials form, no personas, no badge
#
# Nothing has to be set to close the doors: an unrecognised project has none.
# src/app/lib/stories.ts holds the showroom's ref and src/app/lib/stories.test.ts
# pins the predicate.
VITE_PLATFORM_SUPABASE_URL="https://<platform-project-ref>.supabase.co"
VITE_PLATFORM_SUPABASE_PUBLISHABLE_KEY="<platform-publishable-key>"
# The Business Passport's issuer: the credit platform's `passport` Edge Function
# (production, not the hackathon project). The passport page trusts this one
# issuer and no other; unset, the page says it is not configured.
VITE_PASSPORT_ISSUER="https://<credit-project-ref>.supabase.co/functions/v1/passport"
