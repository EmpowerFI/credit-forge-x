{
  "version": "6.0",
  "screens": [
    {
      "id": "VENDAS",
      "title": "Registro do dia",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "day",
            "label": "De que dia é este registro?",
            "required": true,
            "init-value": "yesterday",
            "data-source": [
              {
                "id": "yesterday",
                "title": "Ontem"
              },
              {
                "id": "today",
                "title": "Hoje"
              }
            ]
          },
          {
            "type": "TextBody",
            "text": "Quanto você vendeu em cada forma de pagamento? Deixe em branco o que não teve."
          },
          {
            "type": "TextInput",
            "name": "sale_pix",
            "label": "Pix",
            "input-type": "number",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "sale_cash",
            "label": "Dinheiro",
            "input-type": "number",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "sale_debit",
            "label": "Cartão de débito",
            "input-type": "number",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "sale_credit",
            "label": "Cartão de crédito",
            "input-type": "number",
            "required": false
          },
          {
            "type": "If",
            "condition": "${form.sale_credit} != ''",
            "then": [
              {
                "type": "DatePicker",
                "name": "sale_credit_due",
                "label": "Quando vai receber do cartão?",
                "required": true
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "sale_fiado",
            "label": "Fiado",
            "input-type": "number",
            "required": false
          },
          {
            "type": "If",
            "condition": "${form.sale_fiado} != ''",
            "then": [
              {
                "type": "DatePicker",
                "name": "sale_fiado_due",
                "label": "Quando vai receber do fiado?",
                "required": true
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "GASTO_1"
              },
              "payload": {
                "day": "${form.day}",
                "sale_pix": "${form.sale_pix}",
                "sale_cash": "${form.sale_cash}",
                "sale_debit": "${form.sale_debit}",
                "sale_credit": "${form.sale_credit}",
                "sale_credit_due": "${form.sale_credit_due}",
                "sale_fiado": "${form.sale_fiado}",
                "sale_fiado_due": "${form.sale_fiado_due}"
              }
            }
          }
        ]
      }
    },
