            "label": "Pagou à vista?",
            "required": false,
            "init-value": "yes",
            "data-source": [
              {
                "id": "yes",
                "title": "Sim"
              },
              {
                "id": "no",
                "title": "Não, vou pagar depois"
              }
            ]
