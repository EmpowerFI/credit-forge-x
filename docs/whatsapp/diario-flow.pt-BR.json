                "exp1_amount": "${form.exp1_amount}",
                "exp1_method": "${form.exp1_method}",
                "exp1_paid_now": "${form.exp1_paid_now}",
                "exp1_due": "${form.exp1_due}"
              }
            }
          },
          {
            "type": "Footer",
            "label": "Enviar",
            "on-click-action": {
              "name": "complete",
